# =============================================================================
# SCENYX Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API (Required)
# Get your API key from: https://platform.openai.com/api-keys
# Requires Sora 2 API access for video generation
# -----------------------------------------------------------------------------
OPEN_API_KEY=sk-your-openai-api-key-here

# -----------------------------------------------------------------------------
# Replicate API (Required for Lip Sync / Avatar features)
# Get your token from: https://replicate.com/account/api-tokens
# -----------------------------------------------------------------------------
REPLIT_KEY=r8_your_replicate_api_token

# -----------------------------------------------------------------------------
# Supabase Database (Required)
# Get these from your Supabase project settings: https://supabase.com/dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Solana Configuration (Required for payments)
# -----------------------------------------------------------------------------
# RPC URL for client-side (can use public RPC or private provider like Helius/QuickNode)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# RPC URL for server-side operations
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# USDC Token Mint Address (mainnet)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Your merchant wallet address to receive USDC payments
MERCHANT_WALLET_ADDRESS=your_solana_wallet_address_here

# -----------------------------------------------------------------------------
# Credits Configuration (Optional)
# -----------------------------------------------------------------------------
# USD value per credit (default: $0.70)
# CREDIT_USD_PER_CREDIT=0.70
