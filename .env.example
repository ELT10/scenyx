# OpenAI API Configuration
# Note: This project uses the non-standard name OPEN_API_KEY
OPEN_API_KEY=sk-your-openai-api-key

# Solana Blockchain Configuration
# RPC URL for client-side interactions (e.g., wallet connection)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# RPC URL for server-side interactions (can be the same as above)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# USDC Token Mint Address (Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Wallet address that receives payments
MERCHANT_WALLET_ADDRESS=your_merchant_wallet_address

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Replicate API Configuration (for Lip Sync and Avatar generation)
# Note: This project uses the non-standard name REPLIT_KEY
REPLIT_KEY=r8_your_replicate_api_token
